<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Lets a debug build talk to a server on the development machine over plain
  http, reached through `adb reverse`, so a feature that fetches a document or posts a result can
  be exercised end to end without standing up real infrastructure first.

  The release source set has the main file instead (src/main/res/xml), with no cleartext to
  anywhere.
-->
<network-security-config>
    <!-- As the main file: ISRG Root X1 beside the phone's own roots, for Android 7.0. -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- The host machine, as seen from the standard emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug only. See res/xml/network_security_config.xml for why. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig">

        <!-- ONNX Runtime from Maven (the parts bench, Unreleased.AUTOMIX_PARTS) starts Microsoft's
             telemetry from this provider at every start of the app: a 1DS client that sends usage
             events to mobile.events.data.microsoft.com. Taken out, so nothing goes there, and the
             runtime's 34 MB library is loaded only when the bench runs. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />

        <!-- A playlist's parts made in one sitting (PartsBatch, Unreleased.AUTOMIX_PARTS): the
             debug app's alone, as the model's runtime is. In the foreground while it splits, with
             its notification to follow and stop it. -->
        <service
            android:name="com.dd3boh.outertune.playback.parts.PartsBatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>

    <string name="player_glass_intensity_value">%1$d%%</string>
    <string name="player_liquid_glass">液態玻璃</string>
    <string name="player_liquid_glass_description">為導覽列、迷你播放器和播放控制項加上浮動玻璃面板，並讓播放畫面背後的封面色彩更豐富</string>

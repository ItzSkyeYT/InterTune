    <string name="flush_image_cache_title">清除已快取的封面</string>
    <string name="flush_image_cache_description">釋放專輯封面佔用的記憶體。需要時會重新取得。</string>
    <string name="song_cache_max_size">歌曲快取上限</string>
    <string name="image_cache_max_size">封面快取上限</string>
    <string name="max_queues_description">應用程式同時保留多少個播放佇列。超過後最舊的會被捨棄。</string>
    <string name="enable_proxy_description">讓應用程式取得的所有內容先經過另一台伺服器。除非你確定需要，否則請保持關閉。</string>
    <string name="show_liked_and_downloaded_playlist_description">在音樂庫中把「已按讚的歌曲」和「已下載的歌曲」顯示為播放清單。</string>
    <string name="pause_listen_history_description">不再將歌曲加入你的收聽紀錄。已經在其中的內容不會被移除。</string>
    <string name="pause_remote_listen_history_description">不再把你播放的內容告訴 YouTube Music。這個應用程式內的紀錄照常繼續。</string>
    <string name="clear_listen_history_description">刪除應用程式記錄的所有你播放過的內容。</string>
    <string name="pause_search_history_description">不再儲存你搜尋的內容。</string>
    <string name="clear_search_history_description">刪除應用程式儲存的所有搜尋紀錄。</string>
    <string name="sync_params_description">唯讀表示應用程式絕不會變更你 YouTube Music 帳戶中的任何內容。衝突處理決定當播放清單在兩邊不一致時會怎麼做。</string>
    <string name="enable_lrclib_description">在 LRCLIB 上尋找歌詞，這是一個免費的社群歌詞資料庫。</string>
    <string name="enable_kugou_description">在酷狗上尋找歌詞。它的收錄量很大，中文音樂尤其完整。</string>
    <string name="audio_normalization_description">拉平歌曲之間的音量，避免某一首突然比上一首大聲很多。</string>
    <string name="skip_silence_description">跳過曲目開頭與結尾的靜音。</string>
    <string name="stop_music_on_task_clear_description">當你從最近使用的應用程式中滑掉它時停止播放。</string>
    <string name="enable_dynamic_theme_description">從你的桌布取用應用程式的配色。</string>
    <string name="pure_black_description">使用純黑而非深灰。在 OLED 螢幕上這還能省一點電。</string>
    <string name="min_playback_duration_short">一首歌要播放多少才算一次播放。</string>
    <string name="throttle_banner_title">YouTube 已暫停這個連線</string>
</resources>

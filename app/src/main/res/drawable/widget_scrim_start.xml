<?xml version="1.0" encoding="utf-8"?>
<!--
  Under the words of a Full cover widget that is wide (a banner, a line): dark at the start, where
  the words are, and lighter towards the end, where the cover is seen. Its numbers are WidgetScrim.START's,
  which the glass over it is drawn with: WidgetScrimTest holds the two together.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="#26000000"
        android:startColor="#99000000" />
</shape>

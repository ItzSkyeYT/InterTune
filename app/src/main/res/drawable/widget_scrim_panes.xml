<?xml version="1.0" encoding="utf-8"?>
<!--
  Under a Full cover widget on a tablet: light where the song and its glass bar are, and darker
  under Up next on the right, so its words read on any cover. WidgetScrim.END's numbers.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:centerColor="#8C000000"
        android:centerX="0.55"
        android:endColor="#CC000000"
        android:startColor="#26000000" />
</shape>

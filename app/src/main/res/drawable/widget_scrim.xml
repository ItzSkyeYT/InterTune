<?xml version="1.0" encoding="utf-8"?>
<!--
  Under the words and buttons of a widget whose cover fills it: clear at the top, where the cover
  should be seen, and dark enough at the bottom for white words over any cover, a white one included.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#66000000"
        android:centerY="0.4"
        android:endColor="#00000000"
        android:startColor="#D9000000" />
</shape>

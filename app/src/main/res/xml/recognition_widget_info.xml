<?xml version="1.0" encoding="utf-8"?>
<!--
  The recognition button as the launcher sees it: two cells wide by one high to begin with, as
  small as one cell, and nothing to configure. No update period: it never changes.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/recognition_widget_description"
    android:initialLayout="@layout/widget_recognition"
    android:minHeight="40dp"
    android:minWidth="110dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="40dp"
    android:previewLayout="@layout/widget_recognition"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />

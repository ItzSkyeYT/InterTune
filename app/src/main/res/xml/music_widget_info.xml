<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget as the launcher sees it before a single pixel of ours is drawn: how big it wants to
  be, how small it may be dragged, and what to show in the picker. Four by two is the size that
  holds the song, its controls and two list rows; one by one is the cover with a play button over it.
  Dragged as small as one cell or as large as the screen, it changes shape rather than scaling.

  Configurable, and reconfigurable: the question of what it holds is asked when it is dropped and
  again from the launcher's own edit button. Not "configuration_optional", which lets a launcher
  skip the question entirely, and then nobody ever learns the widget can be anything else.

  No update period: the app redraws the widget itself whenever it has something to say, and a timer
  would only wake the phone to redraw the same thing. Force stopping the app empties its widget
  until the app is next opened, which is Android's rule for every widget and not something a period
  can mend, since a stopped app receives no broadcasts at all.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.dd3boh.outertune.widget.WidgetConfigActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minHeight="110dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="40dp"
    android:minWidth="180dp"
    android:maxResizeHeight="600dp"
    android:maxResizeWidth="500dp"
    android:previewImage="@drawable/widget_preview_image"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />

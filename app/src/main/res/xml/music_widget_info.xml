<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget as the launcher sees it before a single pixel of ours is drawn: how big it wants to
  be, how small it may be dragged, and what to show in the picker. Four by two is the size that
  holds the song, its controls and two Quick picks; two by one still holds a song and a play button.

  The app redraws the widget itself whenever it has something new to say, so the update period is
  not how it keeps up. It is once a day purely as a way back: Android empties a widget when its app
  is force stopped, and without a single scheduled update a widget emptied that way would sit blank
  until its owner next opened the app.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minHeight="110dp"
    android:minResizeHeight="70dp"
    android:minResizeWidth="110dp"
    android:minWidth="180dp"
    android:maxResizeHeight="440dp"
    android:maxResizeWidth="500dp"
    android:previewImage="@drawable/widget_preview_image"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="86400000"
    android:widgetCategory="home_screen" />

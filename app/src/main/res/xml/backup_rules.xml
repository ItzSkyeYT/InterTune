<?xml version="1.0" encoding="utf-8"?><!--
   Android 11 and earlier, where one set of rules covers the cloud backup and a transfer alike. The
   settings file holds the YouTube Music sign-in and the Last.fm session, the web view the sign-in
   pages open in keeps their cookies in app_webview, and the liked songs snapshot names the
   account, so all three stay out of both. So does an import from another service that is under
   way (library-import): megabytes that would count against the 25 MB the library has to fit in.

   The app's own logs, one file per run for Report a problem (logs, RunLogs), belong to this phone
   and stay out: up to some megabytes, and of no use on another phone.

   The tester lock of a preview published for testers keeps the tester's code and the random install
   number the app made for itself in tester_lock.xml. The door holds a code for one install, so an app
   that is restored or transferred must make its own number and take the code again with /code on
   Discord: the file stays out of the backup and out of a transfer alike.
-->
<full-backup-content>
    <exclude
        domain="file"
        path="logs/" />
    <exclude
        domain="file"
        path="datastore/" />
    <exclude
        domain="root"
        path="app_webview/" />
    <exclude
        domain="file"
        path="liked_sync/" />
    <exclude
        domain="file"
        path="library-import/" />
    <exclude
        domain="file"
        path="./exoplayer" />
    <exclude
        domain="file"
        path="./download" />
    <exclude
        domain="database"
        path="exoplayer_internal.db" />
    <exclude
        domain="sharedpref"
        path="tester_lock.xml" />
</full-backup-content>
<?xml version="1.0" encoding="utf-8"?><!--
   Android 11 and earlier, where one set of rules covers the cloud backup and a transfer alike. The
   settings file holds the YouTube Music sign-in and the Last.fm session, so it stays out of both.
-->
<full-backup-content>
    <exclude
        domain="file"
        path="datastore/" />
    <exclude
        domain="file"
        path="./exoplayer" />
    <exclude
        domain="file"
        path="./download" />
    <exclude
        domain="database"
        path="exoplayer_internal.db" />
</full-backup-content>
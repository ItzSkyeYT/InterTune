<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked of the car, not of the phone: to be drawn as a music app from templates. -->
    <uses-permission android:name="androidx.car.app.MEDIA_TEMPLATES" />
    <!-- Lets the app hand a downloaded release to Android's installer. Android still asks the user
         to allow this app to install apps, and still shows its own confirmation for every install:
         nothing is installed without two explicit taps. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live Updates: lets the download notification be promoted to the status bar chip and,
         on Samsung, the Now Bar. Not a runtime permission, there is nothing to prompt for. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>

    <!--
      Song recognition only. Requested when the user starts listening, never at launch. It listens
      to the room only while asked to, in windows of 8 to 20 seconds, and at no other time, and the
      recording is fingerprinted in memory and discarded: no audio is written to disk or sent
      anywhere. What leaves the device is the signature, which is a few hundred numbers describing
      peaks and cannot be turned back into sound.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Song recognition of the phone's own sound: the projection it needs is held by a service of
         that type (recognition/PhoneAudio). Nothing is projected without the user's yes each time. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <queries>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>
    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:appCategory="audio"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OuterTune"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu">
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <!-- Turning the phone, a window resized in split screen, a foldable opened or a keyboard
             plugged in: the screen lays itself out again and keeps everything on it. Made anew
             on each of those, it lost whatever was open or half done (a dialog, lines being picked,
             a video being made). Its layouts follow the window's size as it changes. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OuterTune"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.MUSIC_PLAYER" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- The phone's own search (search/SystemSearch.kt), in every build from 0.12: MainActivity is
                 the searchable that puts the app in One UI's "Apps to search in". -->
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/system_searchable" />

            <!-- The app's own links, which the share page (intertune.app/s/) opens it with where a
                 browser keeps YouTube's addresses to itself: Brave refuses a page's link to one
                 while "Open YouTube links in Brave" is on (brave-browser#46614). YouTubeLink reads
                 them as the same pages. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="intertune" />
            </intent-filter>

            <!-- The share page's links (intertune.app/s/#v=...), tapped in a chat or any other app, open
                 here straight away once Android has checked intertune.app/.well-known/assetlinks.json,
                 which names the app (verified domain by domain from Android 12). Without the app they
                 stay the page. What to open is after the #, which a filter cannot see: YouTubeLink
                 reads it. The page's two paths only, so the rest of the site stays in the browser: a
                 pathPrefix of "/s" would take /sitemap.xml too. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="intertune.app" />
                <data android:path="/s" />
                <data android:path="/s/" />
            </intent-filter>

            <!-- Youtube filter -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="music.youtube.com" />
                <!-- video prefix -->
                <data android:pathPrefix="/v/" />
                <data android:pathPrefix="/embed/" />
                <data android:pathPrefix="/watch" />
                <!-- channel prefix -->
                <data android:pathPrefix="/channel/" />
                <data android:pathPrefix="/user/" />
                <data android:pathPrefix="/c/" />
                <!-- playlist prefix -->
                <data android:pathPrefix="/playlist" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
                <data android:pathPrefix="/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="vnd.youtube" />
                <data android:scheme="vnd.youtube.launch" />
            </intent-filter>

            <!-- Play from search: "play X" from a voice assistant, a car or an automation app, with
                 the words in SearchManager.QUERY and no data. The YouTube filters above name this
                 action too, but they also want a link, so a plain request never matched them.
                 MainActivity hands the words to the media session. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Share filter -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The phone's own search asks this for suggestions from the library, readable only by a
             search holding GLOBAL_SEARCH. Named by the build's id, so each build has its own. -->
        <provider
            android:name="com.dd3boh.outertune.search.SystemSearchProvider"
            android:authorities="${applicationId}.systemsearch"
            android:exported="true"
            android:readPermission="android.permission.GLOBAL_SEARCH" />

        <!-- Covers for Android Auto, which loads pictures from a content address and not from the web. Read only,
             and open to the car, which holds no permission of ours to ask for. -->
        <provider
            android:name=".playback.AutoArtProvider"
            android:authorities="${applicationId}.autoart"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- The settings Android Auto opens from the cog over the app's tabs. It lets in a car's own software only. -->
        <service
            android:name=".playback.AutoSettingsService"
            android:enabled="${carScreens}"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.SETTINGS" />
            </intent-filter>
        </service>

        <!-- The car's tap on that cog, with a refusal of the screen caught instead of crashing (AutoSettingsLink). -->
        <receiver
            android:name=".playback.AutoSettingsReceiver"
            android:enabled="${carScreens}"
            android:exported="false" />

        <!-- The app's own screens in a car that draws a music app from templates (AutoCar). -->
        <service
            android:name=".playback.AutoCarService"
            android:enabled="${carScreens}"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.MEDIA" />
            </intent-filter>
        </service>

        <!-- The oldest version of the car's screens that knows a settings screen. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="6" />

        <provider
            android:name=".utils.SharedFileProvider"
            android:authorities="${applicationId}.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <service
            android:name=".playback.MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          The home screen widget. Its updates come from the app itself as things happen, never on
          a timer, so nothing here wakes for a widget with nothing new to show.
        -->
        <!-- What a widget holds, asked when it is dropped and answerable again from the launcher. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/widget_label"
            android:theme="@style/Theme.InterTune.WidgetConfig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.MusicWidgetReceiver"
            android:enabled="true"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_info" />
        </receiver>

        <!--
          Replaces media3's own receiver rather than sitting beside it: media3 expects exactly one
          receiver for MEDIA_BUTTON and throws on two.
        -->
        <receiver
            android:name=".playback.ResumingMediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!--
          Listening continues with the screen off, which Android only allows a foreground service
          holding the microphone type. The notification it must show is the point rather than a
          nuisance: an app recording a room should always be visible and stoppable.
        -->
        <service
            android:name=".recognition.RecognitionService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection" />

        <!--
          Song on this phone: a Quick Settings tile that names the song in what is playing on the
          phone without leaving it (recognition/PhoneSongTileService). Its tap shows only Android's
          question to record, over the video, through an activity with nothing on it.
        -->
        <service
            android:name=".recognition.PhoneSongTileService"
            android:exported="true"
            android:icon="@drawable/ic_recognise_phone"
            android:label="@string/recognition_phone_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>
        <activity
            android:name=".recognition.PhoneListenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          The tile in Quick Settings and the button on the home screen open the recognition screen
          already listening (RecognitionShortcut). Neither starts the microphone by itself: from
          Android 14 a microphone service can only start with the app in front, and the screen is
          where the permission is asked and the run can be seen and stopped.
        -->
        <service
            android:name=".recognition.RecognitionTileService"
            android:exported="true"
            android:icon="@drawable/ic_recognise"
            android:label="@string/recognition_room_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>
        <!--
          The third tile, "What's playing?", asks which of the two in a small question over the
          panel and starts the one tapped (recognition/RecognitionChoiceTileService).
        -->
        <service
            android:name=".recognition.RecognitionChoiceTileService"
            android:exported="true"
            android:icon="@drawable/ic_recognise_ask"
            android:label="@string/recognise"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

        <receiver
            android:name=".widget.RecognitionWidgetReceiver"
            android:exported="false"
            android:label="@string/recognise">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recognition_widget_info" />
        </receiver>

        <service
            android:name=".playback.ExoDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!--
            The job media3's PlatformScheduler hands to Android when downloads have to wait (for
            Wi-Fi, for charging, for storage): ExoDownloadService.getScheduler builds one in its
            onCreate, and JobScheduler refuses a job whose service is not declared here, which
            crashed the download service on start (issue #43). Bound by the system alone.
        -->
        <service
            android:name="androidx.media3.exoplayer.scheduler.PlatformScheduler$PlatformSchedulerService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    
</application>


    <!--
        Only for "Quieter as you walk away" under Player and audio, on Android 12 and up, and
        requested at the point of use rather than assumed at install. A debug build has a signal
        log beneath that setting as well, which listens to every device; a release does not.
        neverForLocation because nothing here wants to know where anyone is: the only question is
        how strong a signal from headphones already paired and connected happens to be.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

</manifest>